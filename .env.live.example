# DO NOT put real values in this file. It is a template that documents which
# variable NAMES to add to your own local .env (already gitignored) when
# you're ready to go live. Never commit a real secret key anywhere.
#
# POLYMARKET_US_KEY_ID     - your Polymarket US API key ID (a public
#                            identifier, issued via their developer portal).
# POLYMARKET_US_SECRET_KEY - your Polymarket US API secret key (a base64
#                            Ed25519 private key, used only for local request
#                            signing -- it is never transmitted anywhere).
#                            Use a key dedicated to this bot if possible.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=
