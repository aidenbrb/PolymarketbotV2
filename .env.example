# This file must NEVER contain an API key ID, secret key, or any credential.
# Everything below is a non-secret tunable. Live-trading credentials go in
# your own local, gitignored .env only -- see .env.live.example for the
# variable names (a separate template file, never this one).

# Polymarket US's public, unauthenticated market-data API.
GATEWAY_API_BASE=https://gateway.polymarket.us

# HTTP client settings.
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=3

# Logging.
LOG_LEVEL=INFO
LOG_MAX_BYTES=20000000
LOG_BACKUP_COUNT=5

# Paper trading starting balance (fake money, USD).
PAPER_STARTING_CASH=1000

# --- Live trading (real money, Polymarket US) ---------------------------
# LIVE_TRADING_ENABLED must be "true" AND a typed confirmation phrase must
# be entered before `live-start` will ever place a real order. Off by default.
LIVE_TRADING_ENABLED=false
LIVE_API_BASE=https://api.polymarket.us
LIVE_ORDER_SHARES_MIN=1
LIVE_ORDER_SHARES_MAX=2
LIVE_NEWEST_MARKET_SCAN_LIMIT=500
LIVE_RECENT_MARKET_SCAN_LIMIT=5000
LIVE_MAX_ORDERS_PER_CYCLE=4
LIVE_USE_WEBSOCKET=true
LIVE_WEBSOCKET_RESPONSES_DEBOUNCED=true
LIVE_WEBSOCKET_STALE_AFTER_SECONDS=10
LIVE_WEBSOCKET_RECONNECT_INITIAL_SECONDS=1
LIVE_WEBSOCKET_RECONNECT_MAX_SECONDS=30
LIVE_WEBSOCKET_CANDIDATE_REFRESH_SECONDS=900
LIVE_WEBSOCKET_CANDIDATE_REFRESH_RETRY_SECONDS=60
LIVE_WEBSOCKET_SUBSCRIPTION_LIMIT=100
LIVE_WEBSOCKET_CANDIDATE_POOL_SIZE=20
LIVE_OBSERVATION_ONLY_MODE=false
LIVE_OBSERVATION_GATE_ENABLED=true
LIVE_OBSERVATION_UNIVERSE_SIZE=100
LIVE_OBSERVATION_RETAINED_ACTIVE_SLOTS=70
LIVE_OBSERVATION_ACTIVE_HOLD_SECONDS=7200
LIVE_OBSERVATION_EVIDENCE_WINDOW_HOURS=72
LIVE_OBSERVATION_MIN_OBSERVED_SECONDS=7200
LIVE_OBSERVATION_MIN_TRADES=20
LIVE_OBSERVATION_MIN_HYPOTHETICAL_FILLS=5
LIVE_OBSERVATION_MIN_FILL_RATE=0.05
LIVE_OBSERVATION_MIN_MARKOUT_SAMPLES=5
LIVE_OBSERVATION_MIN_AVG_MARKOUT_CENTS=0.25
LIVE_OBSERVATION_MIN_AVG_MARKOUT_5M_CENTS=0.0
LIVE_OBSERVATION_MIN_DISTINCT_FILL_EPISODES=3
LIVE_OBSERVATION_FILL_EPISODE_GAP_SECONDS=300
LIVE_OBSERVATION_MIN_PAPER_ROUND_TRIPS=3
LIVE_OBSERVATION_MIN_PAPER_PNL_USD=0.0
LIVE_OBSERVATION_MAKER_FEE_THETA=-0.0125
LIVE_OBSERVATION_TAKER_FEE_THETA=0.06
LIVE_OBSERVATION_PERSIST_INTERVAL_SECONDS=10
LIVE_OBSERVATION_FEED_STALE_AFTER_SECONDS=300
LIVE_OBSERVATION_MIN_FEED_COVERAGE_RATIO=0.90
LIVE_OBSERVATION_EVALUATION_HOURS=48
LIVE_OBSERVATION_LEGACY_MAX_STARTED_EVENT_HOURS=6
LIVE_OBSERVATION_LEGACY_MAX_SPREAD=0.98
LIVE_OBSERVATION_LEGACY_ORDER_SHARES=17.5
LIVE_OBSERVATION_CONTROLLED_MAX_STARTED_EVENT_HOURS=3
LIVE_OBSERVATION_CONTROLLED_MAX_SPREAD=0.50
LIVE_OBSERVATION_CONTROLLED_ORDER_SHARES=1
LIVE_OBSERVATION_PROFILE_REFRESH_SECONDS=60
LIVE_OBSERVATION_PROFILE_MAX_MARKETS=5
LIVE_OBSERVATION_CONTROLLED_MAX_MARKETS_PER_EVENT=3
LIVE_OBSERVATION_CONTROLLED_PREGAME_PAUSE_MINUTES=60
LIVE_OBSERVATION_CONTROLLED_ENTRY_CUTOFF_MINUTES=30
LIVE_OBSERVATION_CONTROLLED_MAX_HOLDING_HOURS=1
LIVE_OBSERVATION_CONTROLLED_MAX_ROUND_TRIPS_PER_MARKET=2
LIVE_OBSERVATION_CONTROLLED_MIN_ROUND_TRIPS=20
LIVE_OBSERVATION_CONTROLLED_MIN_DISTINCT_EVENTS=5
LIVE_OBSERVATION_COHORT_MIN_ROUND_TRIPS=5
LIVE_OBSERVATION_COHORT_MIN_DISTINCT_EVENTS=2
LIVE_OBSERVATION_CONTROLLED_MIN_PROFIT_FACTOR=1.20
LIVE_OBSERVATION_CONTROLLED_MAX_DRAWDOWN_USD=3
LIVE_OBSERVATION_CONTROLLED_MAX_EVENT_PROFIT_CONCENTRATION=0.50
LIVE_PILOT_ENTRY_HOURS=3.5
LIVE_PILOT_DRAIN_MINUTES=30
LIVE_PILOT_MAX_ROUND_TRIPS_PER_MARKET=2
# REST retry/backoff for read-only calls (get_open_orders, get_all_positions,
# get_position) -- NOT order placement/cancellation, which stay single-
# attempt fail-fast. LIVE_RATE_LIMIT_BACKOFF_MULTIPLIER scales the backoff
# specifically harder for a 429 than a generic transient failure.
LIVE_REQUEST_TIMEOUT_SECONDS=10.0
LIVE_REQUEST_MAX_RETRIES=3
LIVE_REQUEST_BACKOFF_BASE_SECONDS=0.5
LIVE_RATE_LIMIT_BACKOFF_MULTIPLIER=4.0
LIVE_MAX_DAYS_TO_CLOSE=3
LIVE_MIN_HOURS_TO_CLOSE=2
LIVE_MAX_STARTED_EVENT_HOURS=0
LIVE_PRE_EVENT_REDUCE_ONLY_MINUTES=60
LIVE_MIN_LIQUIDITY=100
LIVE_MIN_VOLUME_24H=0
LIVE_LIQUIDITY_FALLBACK_MAX_LOOKUPS=500
LIVE_STICKY_MARKET_ALLOCATION_ENABLED=true
LIVE_STICKY_MARKET_HOLD_SECONDS=300
LIVE_PRICE_HYSTERESIS_TICKS=1
LIVE_MIN_RESTING_SECONDS=90
LIVE_STARTUP_CRASH_RECOVERY_ENABLED=true
LIVE_EXECUTION_BACKFILL_MAX_LOOKUPS_PER_CYCLE=5
LIVE_EXECUTION_BACKFILL_MIN_INTERVAL_SECONDS=0.1
LIVE_MAX_SPREAD=0.98
LIVE_EXCLUDE_MARKET_TYPES=
LIVE_EXCLUDE_QUESTION_KEYWORDS=champion,championship,mvp,cy young,pennant,temperature
# "climate" is Polymarket's real tag for intraday weather-threshold markets
# (e.g. "tc-temp-*" slugs) -- excluded by default since the edge there
# depends on external meteorological truth the bot doesn't model.
LIVE_EXCLUDE_CATEGORIES=climate
LIVE_EXCLUDE_SLUG_PREFIXES=tc-temp
# raw["sportsMarketType"] == "esports_match_winner" is the one clean signal
# that distinguishes esports (Dota2/LoL/Valorant/CS2) from traditional
# sports -- category and marketType are both shared with real sports
# markets, and slug prefixes ("atc-"/"aec-") are shared org codes, not
# game-specific. The bot has no real signal on competitive-gaming outcomes.
LIVE_EXCLUDE_SPORTS_MARKET_TYPES=esports_match_winner
LIVE_MIN_TOP_DEPTH_SHARES=10
LIVE_MIN_TOTAL_DEPTH_SHARES=25
LIVE_DEPTH_LEVELS_TO_CHECK=3
# Safe default is true: require a real, fresh L2 order book before quoting
# at all -- never silently fall back to pricing off a bare BBO number.
LIVE_REQUIRE_L2_DEPTH=true
# Off by default: OUTCOME_SIDE_YES is only verified correct for a literal
# two-outcome Yes/No market (see live/RUNBOOK.md's binary-market
# restriction). Only set true once that mapping is confirmed for whatever
# non-binary market type you're trying to allow.
LIVE_ALLOW_NON_BINARY_MARKETS=false
# Adverse-selection guard: skip quoting a market whose recent price move
# exceeds this many cents within the window below.
LIVE_VOLATILITY_FILTER_ENABLED=true
LIVE_MAX_RECENT_MOVE_CENTS=3.0
LIVE_VOLATILITY_WINDOW_SECONDS=300
LIVE_ACTIVITY_TRACKING_ENABLED=true
LIVE_ACTIVITY_WINDOW_SECONDS=300
# Scaffold only (see live/ws_private.py, live/RUNBOOK.md): streams private
# order/position/balance updates for visibility. No trading decision reads
# from it yet.
LIVE_ENABLE_PRIVATE_WEBSOCKET=true
LIVE_PRIVATE_ORDER_STATE_ENABLED=true
LIVE_PRIVATE_STATE_RECONCILE_SECONDS=1200
LIVE_PRIVATE_STATE_STALE_AFTER_SECONDS=120
LIVE_PRIVATE_STATE_DEGRADED_CANCEL_SECONDS=120
# Minimum spread (cents) that must remain after improving both sides of the
# real book by one tick, before the bot bothers quoting at all. Below this
# there's no real edge -- see live/pricing.py::compute_book_aware_quote.
LIVE_MIN_EDGE_CENTS=0.5
# Max position value (USD, mark-to-market) before the bot stops adding to a
# position -- it keeps quoting the reducing side but skips the increasing
# side once hit. See live/pricing.py::apply_cost_basis_floor.
LIVE_MAX_POSITION_USD=40
LIVE_INVENTORY_SKEW_ENABLED=true
LIVE_INVENTORY_SKEW_THRESHOLD_USD=10
LIVE_INVENTORY_REDUCING_SIZE_MULTIPLIER=1.5
LIVE_INVENTORY_INCREASING_SIZE_MULTIPLIER=0.5
LIVE_REFRESH_INTERVAL_SECONDS=10
LIVE_ORDER_SETTLEMENT_SECONDS=15
LIVE_ONE_ROUND_TRIP_PER_MARKET_PER_SESSION=true
LIVE_INCENTIVE_CATEGORIES=politics,macro,culture,sports
# 1-minute/5-minute/15-minute realized-spread markout tracking. See
# live/RUNBOOK.md's "-9." section and most recent section (15m added).
LIVE_MARKOUT_TRACKING_ENABLED=true
# If a fill's mark is overdue by more than this, it's resolved to None
# instead of computed against today's BBO (would be meaningless).
LIVE_MARKOUT_MAX_STALENESS_SECONDS=900.0
# Duration of the third, longer markout window -- added after 1m/5m missed
# a real slow-grind loss (a fill that looked fine at 1m/5m kept drifting
# against the bot for much longer).
LIVE_MARKOUT_LONG_WINDOW_SECONDS=900.0
# Lowest non-rejected tier (REJECT/WATCH/STRONG_WATCH/PAPER_CANDIDATE). The
# real quality floor is MarketFilters (liquidity/volume/spread ceiling/price
# range), enforced before scoring. Requiring a higher tier here fights the
# live selection's own widest-spread-first ranking, since that score rewards
# a TIGHT spread -- the opposite of what a market maker needs.
LIVE_MIN_RECOMMENDATION=WATCH

# Daily-loss circuit breaker: recommended default is ON. It automatically
# cancels all live orders and halts new quoting if today's account balance
# drops below the limit below. You can disable it by setting this to false --
# that is your explicit choice to make, not something forced on you.
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_DAILY_LOSS_LIMIT_USD=3

# Session-scoped circuit breaker: measures P/L since THIS live-start process
# began (in-memory only -- no state file, resets automatically on every
# restart), separate from the UTC-midnight-resetting daily breaker above.
# There is no reset CLI command for this one, by design: restarting
# live-start IS the reset. See live/RUNBOOK.md's most recent section.
SESSION_CIRCUIT_BREAKER_ENABLED=true
SESSION_CIRCUIT_BREAKER_LOSS_LIMIT_USD=3

# Equity protection: a lifetime/session peak-account-value drawdown stop,
# plus a same-day profit-lock order-size reduction. See
# live/RUNBOOK.md's "-9." section.
EQUITY_PROTECTION_ENABLED=true
# Not derivable from any Polymarket balance field -- set this to your own
# real account value to activate the drawdown-from-peak stop below. Left at
# 0.0 (the default), that check stays inactive; the same-day profit-lock
# sizing check further below is still active regardless of this value.
EQUITY_PROTECTION_STARTING_CAPITAL_USD=0.0
EQUITY_PROTECTION_DRAWDOWN_PCT=5.0
# Same-day profit lock: once today's P/L crosses this, order size is halved
# (see EQUITY_PROTECTION_SIZE_MULTIPLIER) for the rest of the UTC day, even
# if P/L later dips back below this threshold (a ratchet).
EQUITY_PROTECTION_PROFIT_LOCK_USD=10
EQUITY_PROTECTION_SIZE_MULTIPLIER=0.5

# Per-market toxicity-aware quote widening: tracks an EWMA of each market's
# 1-minute markout; crossing the adverse threshold triggers a cooldown
# (wider min_edge_cents, halved size, reduce-only). See
# live/RUNBOOK.md's "-9." section.
TOXICITY_TRACKING_ENABLED=true
TOXICITY_EWMA_ALPHA=0.3
TOXICITY_ADVERSE_THRESHOLD_CENTS=-1.0
TOXICITY_COOLDOWN_SECONDS=600.0
TOXICITY_MIN_EDGE_MULTIPLIER=2.0
TOXICITY_SIZE_MULTIPLIER=0.5

# Event-level correlation-aware capital allocation: markets sharing the same
# underlying real-world event (see live/event_exposure.py) are capped as ONE
# risk bucket, not treated as independently diversified positions. See
# live/RUNBOOK.md's most recent event-exposure section.
# NOTE: fraction semantics (0.20 = 20%), unlike EQUITY_PROTECTION_DRAWDOWN_PCT's
# percent-number semantics (20.0), despite the shared "_PCT" suffix.
LIVE_MAX_EVENT_EXPOSURE_PCT=0.15
LIVE_WARN_EVENT_EXPOSURE_PCT=0.10
LIVE_MAX_MARKETS_PER_EVENT=2
LIVE_STAT_PROP_MAX_EVENT_EXPOSURE_PCT=0.10
LIVE_EVENT_EXPOSURE_WARN_EDGE_MULTIPLIER=1.25
LIVE_EVENT_EXPOSURE_WARN_SIZE_MULTIPLIER=0.75

# Risk-tightening batch: require extra edge opening a position priced near
# an extreme (lopsided payoff) or nearing a market's own resolution time
# (more likely to be informed), plus a static payoff-loss-to-captured-spread
# screen. See live/RUNBOOK.md's most recent section.
LIVE_EXTREME_PRICE_LOW_THRESHOLD=0.15
LIVE_EXTREME_PRICE_HIGH_THRESHOLD=0.85
LIVE_EXTREME_PRICE_MIN_EDGE_CENTS=4.0
LIVE_MAX_PAYOFF_LOSS_TO_CAPTURE_RATIO=20.0
LIVE_REQUIRE_BOTH_ENTRY_LEGS=true
LIVE_FLAT_FIRST_INVENTORY_ENABLED=true
LIVE_HARD_FLATTEN_MINUTES_BEFORE_EVENT=90
LIVE_HARD_FLATTEN_ON_MAX_HOLDING_ENABLED=true
LIVE_NEAR_RESOLUTION_HOURS_THRESHOLD=24.0
LIVE_NEAR_RESOLUTION_MIN_EDGE_MULTIPLIER=2.0
# Reduce-only exit urgency: patient (no aggressive skew nudge, skipped
# entirely while in a toxicity cooldown) unless over the event-exposure cap,
# near resolution, or the daily/session circuit breaker is approaching its
# loss limit (this fraction). See live/RUNBOOK.md's most recent section.
LIVE_BREAKER_RISK_WARNING_FRACTION=0.75
LIVE_LIQUIDATION_MAX_HOLDING_HOURS=1
LIVE_LIQUIDATION_MAX_LOSS_CENTS=5
LIVE_LIQUIDATION_URGENT_MAX_LOSS_CENTS=10
LIVE_LIQUIDATION_MAX_LOSS_USD=2

# P&L attribution: position-snapshot capture + settlement detection
# ("Strategy B") run alongside fill-based FIFO lot matching ("Strategy A")
# every cycle. See live/RUNBOOK.md's most recent section.
LIVE_POSITION_SNAPSHOT_ENABLED=true
LIVE_SETTLEMENT_DETECTION_ENABLED=true
LIVE_PNL_RECONCILE_TOLERANCE_USD=0.05
